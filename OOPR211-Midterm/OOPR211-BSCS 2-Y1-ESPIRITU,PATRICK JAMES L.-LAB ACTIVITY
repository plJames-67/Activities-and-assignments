        int sec_max = numb[6];
        return sec_max;
    }

    static int getSecondSmallest(int[] numb) {
       Arrays.sort(numb);
        
        int Sec_min = numb[1];
        return Sec_min;
    }

    static void Lab_Prog2() {
        int size = 8;
        int[] numb = new int[size];

        System.out.println("Please enter 8 integers:");
        for (int i = 0; i < size; i++) {
            System.out.print("Enter number " + (i + 1) + ": ");
            numb[i] = input.nextInt();
        }

        RemoveDupe(numb);
        System.out.println(getSecondLargest(numb));
        System.out.println(getSecondSmallest(numb));

    }

    static void Lab_Prog3() {
        int n = 5;
        int[] arr = new int[n];

        System.out.print("Enter Data in Array: ");
        for (int i = 0; i < n; i++) {
            arr[i] = input.nextInt();
        }

        System.out.print("Stored Data in Array: ");
        for (int i = 0; i < n; i++) {
            System.out.print(arr[i] + " ");
        }
        System.out.println();

        System.out.print("Enter position of Element to Delete (0-" + (n - 1) + "): ");
        int pos = input.nextInt();

        if (pos < 0 || pos >= n) {
            System.out.println("Invalid position. Nothing deleted.");
            return;
        }

        for (int i = pos; i < n - 1; i++) {
            arr[i] = arr[i + 1];
        }
        n--;

        System.out.print("New data in Array: ");
        for (int i = 0; i < n; i++) {
            System.out.print(arr[i] + " ");
        }
        System.out.println();
    }

    static void Lab_Prog4() {
        System.out.print("Enter Size of Array: ");
        int size = input.nextInt();

        if (size <= 0) {
            System.out.println("Size must be greater than 0.");
            return;
        }

        int[] numb = new int[size];

        System.out.print("Enter any " + size + " elements in Array: ");
        for (int i = 0; i < size; i++) {
            numb[i] = input.nextInt();
        }

        System.out.print("Even Elements: ");
        for (int i = 0; i < size; i++) {
            if (numb[i] % 2 == 0) {
                System.out.print(numb[i] + " ");
            }
        }
        System.out.println();

        System.out.print("Odd Elements: ");
        for (int i = 0; i < size; i++) {
            if (numb[i] % 2 != 0) {
                System.out.print(numb[i] + " ");
            }
        }
        System.out.println();
    }

