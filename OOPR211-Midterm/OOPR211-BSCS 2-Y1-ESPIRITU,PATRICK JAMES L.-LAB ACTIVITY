    }

    public static void main(String[] args) {
        Scanner input = new Scanner(System.in);
         char continueChoice;
         
        do{
        System.out.print("Choose the program you want to run:");
        
        int decision = input.nextInt();
        switch(decision){
            case 1:
                Lab_Prog1();
            case 2:
