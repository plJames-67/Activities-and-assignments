        Student s1 = new Student();

        Student s2 = new Student("S1001", "Maria Santos",
                                 new Date("14/03/2004"), 112);

        System.out.println(s1.getStudentName() + ", " + s1.getTariffPoints());
        System.out.println(s2.getStudentName() + ", " + s2.getTariffPoints());
        System.out.println("Students created: " + Student.getNoOfStudents());

        try {
